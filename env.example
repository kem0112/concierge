# pk-206 の ~/.config/concierge/env（chmod 600）。このファイル自体は見本で、値は入れない。
GMAIL_USER=（受け皿の Gmail アドレス）
GMAIL_APP_PASSWORD=（受け皿 Gmail のアプリパスワード）
NC_USER=kem0112
NC_PASS=（Nextcloud のアプリパスワード pk-206-concierge）
CONCIERGE_DISCORD_TOKEN=（Discord Developer Portal の Concierge アプリのトークン）
CONCIERGE_CHANNEL_ID=（#concierge のチャンネルID）
CONCIERGE_ALLOWED_USER_IDS=（自分の Discord ユーザーID）
# 宛先アドレスの一部=呼び名（どのアカウント宛てのメールかの判定に使う）
MAIL_ACCOUNTS=outlook.jp=メイン,st.kyoto-u.ac.jp=大学,yuta.ikema.1@=就活,carlyshay0112@=Google
# 任意: 毎朝のブリーフの時刻（既定 08:00）
# CONCIERGE_BRIEF_TIME=08:00
# 任意: 夕方のブリーフの時刻（既定 18:00）
# CONCIERGE_EVENING_TIME=18:00
# 任意: 自動アーカイブ（広告・通知を受信トレイから外す）。最初の1週間は 0 のままラベルだけで精度を見る
# CONCIERGE_AUTO_ARCHIVE=0
# 任意: 郵便受けを見る間隔（分。既定 10）
# CONCIERGE_POLL_MINUTES=10
# 任意: Codex のモデルの使い分け（codex の /model に出る名前を小文字・ハイフンで。例: gpt-6-luna）
#   light = メールの仕分け（件数が多い）/ main = ブリーフ（1日1回）。未設定なら Codex の既定
# CODEX_MODEL_LIGHT=gpt-6-luna
# CODEX_EFFORT_LIGHT=low
# CODEX_MODEL_MAIN=
# CODEX_EFFORT_MAIN=
# 任意: 大学・就活・VIP 以外のメールを、まとめて仕分けるまで待つ時間（分。既定 60）
# CONCIERGE_BATCH_WAIT_MIN=60
